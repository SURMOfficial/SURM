// Ne pas éditer, ce fichier est généré par FireDescriptorFileWriter_Specific


export Descriptor_Fire_Smoke_Test is TEntityDescriptor
(
    World              = WorldIndices_Fires
    DescriptorId       = GUID:{329c7b23-6c92-473c-b24f-0212c1c6a252}
    ClassNameForDebug  = 'Fire_Frag_Smoke_Test'
    ModulesDescriptors = [
        ~/SimpleTypeUnitModuleDescriptor,
        ~/EmptyTagsModuleDescriptor,
        ~/FirePositionModuleDescriptor,
        ~/LinkTeamModuleDescriptor,
        ApparenceModel is
            TApparenceModuleDescriptor
        (
            ReferenceMesh  = $/GFX/DepictionResources/Rien
            Depiction  = TTimelyDepictionReceiverFactory( DepictionDescriptor = Template_DescriptorFire_Depiction
            (
                     Radius               = 1
                     FX                   = $/GFX/GameFx/fx_binder_fire
                     Density              = 1
            ))
            DefaultVisibility  = True
            ),

        // Fire
            TFireModuleDescriptor
            (
                TimeToLive                     = 1
                TimeBeforeSpreading            = 1
                TimeBeforeSpreadAttempt        = 1
                SpreadProbability              = 0.0
                IsNewFireProbability           = 0.0
                RadiusGRU                         = 5
                AmmunitionForBurn              = $/GFX/Weapon/Ammo_Howz_Canon_D20_Howitzer_152mm_SMOKE // Ammo_Degats_smoke
                TimeBetweenBurns               = 80
                OverridenSpreadDescriptor      = nil
                SmokeDescriptor                = $/GFX/Weapon/Descriptor_Smoke_Fumi152mm
            ),

    ]
)
