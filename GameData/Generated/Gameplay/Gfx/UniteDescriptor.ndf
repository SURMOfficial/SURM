                     SearchedTagsInEngagementTarget = [
                        "AllUnits",
                     ]
        ),
        TCubeActionModuleDescriptor
        (
            CubeActionDescriptor = $/GFX/UI/CubeAction_Menu_Ordres_unites
        ),
