        (
                ValidOrders = ~/Descriptor_OrderAvailability_Airborne_Scout_US
        ),
        TOrderableModuleDescriptor
        (
            UnlockableOrders = ~/Descriptor_OrderAvailability_Airborne_Scout_US
        ),
        ~/OrderDisplayModuleDescriptor,
            ~/GroupableUnitModuleSelector,
