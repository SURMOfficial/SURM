                    AutoOrientation = True
                    UseTopArmorAgainstFire = False
        ),
        TDangerousnessModuleDescriptor(Dangerousness  = 75),
        TRoutModuleDescriptor(MoralLevel = 0),
        FacingInfos is ~/FacingInfosModuleDescriptor,
