        ~/TargetDataModuleDescriptor,
        ~/PackSignauxModuleDescriptor,
            TStrategicDataModuleDescriptor
                (
                    UnitAttackValue = -9
                    UnitDefenseValue = -9
                    UnitBonusXpPerLevelValue = 1
             ),
            TUnitUIModuleDescriptor
            (
                UnitRole = 'tank_D'
