                    ]
        ),
        TReverseScannerWithIdentificationDescriptor
        (
            VisibilityRollRule = TModernWarfareVisibilityRollRule
            (
                IdentifyBaseProbability     = IdentProbMult * 0.26
                TimeBetweenEachIdentifyRoll = IdentTimeMult * 8.0
                VisibilityRuleDescriptor    = $/GFX/VisionRules/StandardWargameVisibilityRollRule
            )
        ),
            TTransportableModuleDescriptor
            (
                TransportedTexture                     = "UseInGame_Transport"
                TransportedSoldier                     = 'T55A_CMD_SOV'
                NbSeatsOccupied                        = 99
                TimeToLoad                             = 0
                IsTowable                              = False
            ),
        TCadavreGeneratorModuleDescriptor( CadavreDescriptor = ~/Descriptor_UnitCadavre_T55A_CMD_SOV ),
        TIAStratModuleDescriptor
                (
                    DatabaseId = 0
