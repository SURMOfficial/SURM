        TProductionModuleDescriptor
                (
                    Factory            = EDefaultFactories/Recons
                    ProductionTime     = 5
                    ProductionRessourcesNeeded = MAP [
                        ($/GFX/Resources/Resource_CommandPoints, 30),
                        ($/GFX/Resources/Resource_Tickets, 30),
