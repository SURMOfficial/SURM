// Sync withPlayerMissionRequestType.h
PlayerMissionRequest is TBaseClass
(
    Unknown                        is 0
    Seize                          is 1
    Hold                           is 2
    Support                        is 3
    ManageArtillery_Focus          is 4
    ManageArtillery_CounterBattery is 5
    ManageArtillery_Auto           is 6
    AirplaneAutoManage             is 7
    Stop                           is 8
    Supply                         is 9
    Length                         is 10
)