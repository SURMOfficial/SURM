StrategicMaxFatiguePerUnit is 8

StrategicFatigueLossOnNextTurn is 1

StrategicEmptyActionPointsOnMaxFatigueRout is true

// Les niveaux de victoire ci-dessous sont du point de vue de l'attaquant
StrategicBattleAttackerFatigueGainAfterBattle is MAP
[
    (EVictoryType/TotalDefeat, 6),
    (EVictoryType/MajorDefeat, 5),
    (EVictoryType/MinorDefeat, 4),
    (EVictoryType/Draw, 3),
    (EVictoryType/MinorVictory, 2),
    (EVictoryType/MajorVictory, 1),
    (EVictoryType/TotalVictory, 1),
    (EVictoryType/NotSpecified, 5),
]

// Les niveaux de victoire ci-dessous sont du point de vue de l'attaquant
StrategicBattleDefenderFatigueGainAfterBattle is MAP
[
    (EVictoryType/TotalDefeat, 1),
    (EVictoryType/MajorDefeat, 1),
    (EVictoryType/MinorDefeat, 2),
    (EVictoryType/Draw, 2),
    (EVictoryType/MinorVictory, 3),
    (EVictoryType/MajorVictory, 4),
    (EVictoryType/TotalVictory, 5),
    (EVictoryType/NotSpecified, 6),
]

